# --- Core ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
PORT=8080
# Shared secret the website sends in the x-api-key header on POST /events and GET /stats
EVENTS_API_KEY=change-me
# Secret used to sign unsubscribe and Telegram-connect links
LINK_SECRET=change-me-too
PUBLIC_BASE_URL=https://automation.example.com
SITE_URL=https://leanprep.in

# dry_run = nothing is sent, every message is logged in the messages table
# live    = messages are really sent
SEND_MODE=dry_run
# Run the scheduler inside the web process (true) or as a separate `npm run worker` (false)
RUN_WORKER=true
TICK_SECONDS=120

# --- Campaign ---
TARGET_SALES=500
CAMPAIGN_START=2026-11-15
CAMPAIGN_END=2026-12-15
COURSE_START=2026-12-01
# Leave empty until a real deadline is decided; templates then skip the deadline line
OFFER_DEADLINE_TEXT=

# --- Email (Azure Communication Services) ---
ACS_CONNECTION_STRING=
EMAIL_FROM=hello@leanprep.in

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) ---
# Off until a WhatsApp Business API account is set up. While false, WhatsApp steps fall back to email/Telegram.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Razorpay ---
RAZORPAY_WEBHOOK_SECRET=
